# Copy this file to .env and change values as needed.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://orderdesk:orderdesk_dev@localhost:5432/orderdesk

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ACCESS_DAYS=30

# OTP: "log" prints the code in the server console (dev). "whatsapp" sends via Meta Cloud API.
OTP_MODE=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=

# Platform admin (add distributors from the app). Phones comma-separated; key >= 24 chars.
PLATFORM_ADMIN_PHONES=
PLATFORM_ADMIN_KEY=
