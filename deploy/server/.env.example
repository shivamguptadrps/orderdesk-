# Copy to .env on the server and fill in. Never commit the real .env.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   -> JWT_SECRET
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   -> DB_PASSWORD

# staging = test server, login codes shown in the app (test data only!)
# prod    = real shops, codes sent by WhatsApp (needs the WHATSAPP_* values)
APP_ENV=staging
OTP_MODE=log

JWT_SECRET=
DB_PASSWORD=

# Platform admin: who may add distributors from the app (comma-separated phones) + secret key
# (key: python3 -c "import secrets; print(secrets.token_urlsafe(32))", at least 24 characters)
PLATFORM_ADMIN_PHONES=
PLATFORM_ADMIN_KEY=

PUSH_MODE=expo
RELATED_JOB_HOUR_IST=2

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
